#
# Dockerfile.streamlit
#
# Multi-stage build for the Streamlit UI that visualises the ABB cobot.
# This builds on top of the ROS container to reuse the ABB packages.
#

# Use the ROS container as base to get pre-built ABB packages
FROM blrd-moveit-ros_moveit as streamlit_ui

# Install additional dependencies for Streamlit
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3-pip \
      && rm -rf /var/lib/apt/lists/*

# Install Python packages for Streamlit
RUN pip install --no-cache-dir --break-system-packages \
    "networkx>=3.1" \
    streamlit \
    plotly \
    urdfpy \
    websockets

# Copy Streamlit application files
WORKDIR /workspace
COPY ros_interface.py urdf_visualizer.py streamlit_app.py threejs_robot_viewer.py websocket_server.py websocket_server_fixed.py main.py ./

# Expose the default Streamlit port and WebSocket port
EXPOSE 8501
EXPOSE 8765

# Set up entrypoint to source ROS when commands are run
SHELL ["/bin/bash", "-c"]
ENTRYPOINT ["bash", "-c", "source /opt/ros/jazzy/setup.bash && source /workspace/install/setup.bash && exec \"$@\"", "--"]
CMD ["streamlit", "run", "/workspace/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
